{
  "name": "@swa/sdk",
  "version": "0.1.0",
  "description": "SWA SDK for integrating credit card surcharging into Stripe checkout",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "stripe",
    "surcharge",
    "payments",
    "credit-card",
    "swa"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "@stripe/stripe-js": ">=1.0.0"
  },
  "devDependencies": {
    "@stripe/stripe-js": "^4.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.6"
  }
}
